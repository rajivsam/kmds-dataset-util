{
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "args": [
        "-lc",
        "source ${workspaceFolder}/.venv/bin/activate && exec bash"
      ]
    }
  },
  "terminal.integrated.env.linux": {
    "VIRTUAL_ENV": "${workspaceFolder}/.venv",
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
  },
  "chat.tools.terminal.autoApprove": {
    "/^cat configs/seattle-911-prep\\.yaml; python - <<'E'\nimport json\nnb=json\\.load\\(open\\('notebooks/seattle_911_calls_eda\\.ipynb'\\)\\)\nfor i,c in enumerate\\(nb\\['cells'\\]\\):\n    print\\('---',i,c\\['cell_type'\\]\\);print\\(''\\.join\\(c\\['source'\\]\\)\\)\nE$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
